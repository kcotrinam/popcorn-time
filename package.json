{
  "name": "popcorn-time",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"pnpm dev:web\" \"pnpm dev:api\"",
    "dev:web": "pnpm --filter @popcorn-time/web dev",
    "dev:api": "pnpm --filter @popcorn-time/api dev",
    "build": "pnpm -r --if-present build",
    "build:web": "pnpm --filter @popcorn-time/web build",
    "build:api": "pnpm --filter @popcorn-time/api build",
    "lint": "pnpm -r --if-present lint",
    "lint:fix": "pnpm -r --if-present lint:fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:web": "pnpm --filter @popcorn-time/web test",
    "test:api": "pnpm --filter @popcorn-time/api test",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose stop db",
    "db:logs": "docker compose logs -f db",
    "db:generate": "pnpm --filter @popcorn-time/api prisma:generate",
    "db:migrate": "pnpm --filter @popcorn-time/api prisma:migrate",
    "db:studio": "pnpm --filter @popcorn-time/api prisma:studio",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down",
    "validate": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.6.2"
  }
}
