generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PreferredLanguage {
  ES
  EN
}

enum Theme {
  SYSTEM
  LIGHT
  DARK
}

enum UserMediaStatus {
  WATCHLIST
  WATCHED
}

model User {
  id                 String            @id @default(uuid()) @db.Uuid
  email              String            @unique @db.VarChar(254)
  emailNormalized    String            @unique @map("email_normalized") @db.VarChar(254)
  passwordHash       String            @map("password_hash")
  emailVerifiedAt    DateTime?         @map("email_verified_at")
  username           String?           @db.VarChar(30)
  usernameNormalized String?           @db.VarChar(30) @map("username_normalized")
  displayName        String            @db.VarChar(80) @map("display_name")
  avatarUrl          String?           @map("avatar_url")
  preferredLanguage  PreferredLanguage @default(ES) @map("preferred_language")
  theme              Theme             @default(SYSTEM)
  lastLoginAt        DateTime?         @map("last_login_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  deletedAt          DateTime?         @map("deleted_at")
  refreshSessions    RefreshSession[]
  verificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  externalIdentities ExternalIdentity[]
  libraryItems       UserMedia[]
  sentRecommendations Recommendation[] @relation("RecommendationSender")
  receivedRecommendations Recommendation[] @relation("RecommendationRecipient")
  createdSharedPlans SharedPlan[] @relation("SharedPlanCreator")
  sharedPlanParticipants SharedPlanParticipant[]

  @@index([deletedAt], map: "users_deleted_at_idx")
  @@map("users")
}

enum SharedPlanStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}
enum SharedPlanParticipantRole {
  CREATOR
  MEMBER
}
enum SharedPlanInvitationStatus {
  PENDING
  ACCEPTED
}
enum SharedPlanProgressStatus {
  NOT_STARTED
  WATCHING
  WATCHED
}

model SharedPlan {
  id String @id @default(uuid()) @db.Uuid
  creatorId String @map("creator_id") @db.Uuid
  provider String @default("tmdb") @db.VarChar(50)
  externalId Int @map("external_id")
  mediaType String @map("media_type") @db.VarChar(16)
  title String @db.VarChar(500)
  posterUrl String? @map("poster_url")
  releaseYear Int? @map("release_year")
  movieRuntimeMinutes Int? @map("movie_runtime_minutes")
  status SharedPlanStatus @default(PENDING)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  completedAt DateTime? @map("completed_at")
  cancelledAt DateTime? @map("cancelled_at")
  creator User @relation("SharedPlanCreator", fields: [creatorId], references: [id], onDelete: Cascade)
  participants SharedPlanParticipant[]
  @@index([creatorId, status, createdAt], map: "shared_plans_creator_status_created_at_idx")
  @@map("shared_plans")
}

model SharedPlanParticipant {
  planId String @map("plan_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  role SharedPlanParticipantRole @default(MEMBER)
  invitationStatus SharedPlanInvitationStatus @default(PENDING) @map("invitation_status")
  progressStatus SharedPlanProgressStatus @default(NOT_STARTED) @map("progress_status")
  movieMinute Int? @map("movie_minute")
  currentSeason Int? @map("current_season")
  lastWatchedEpisode Int? @map("last_watched_episode")
  invitedAt DateTime @default(now()) @map("invited_at")
  acceptedAt DateTime? @map("accepted_at")
  progressUpdatedAt DateTime? @map("progress_updated_at")
  completedAt DateTime? @map("completed_at")
  plan SharedPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([planId, userId])
  @@index([userId, invitationStatus, invitedAt], map: "shared_plan_participants_user_invitation_invited_at_idx")
  @@map("shared_plan_participants")
}

enum RecommendationStatus {
  PENDING
  ACCEPTED
}

model Recommendation {
  id String @id @default(uuid()) @db.Uuid
  senderId String @map("sender_id") @db.Uuid
  recipientId String @map("recipient_id") @db.Uuid
  provider String @default("tmdb") @db.VarChar(50)
  externalId Int @map("external_id")
  mediaType String @map("media_type") @db.VarChar(16)
  title String @db.VarChar(500)
  posterUrl String? @map("poster_url")
  releaseYear Int? @map("release_year")
  status RecommendationStatus @default(PENDING)
  createdAt DateTime @default(now()) @map("created_at")
  acceptedAt DateTime? @map("accepted_at")
  sender User @relation("RecommendationSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("RecommendationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  @@unique([senderId, recipientId, provider, externalId, mediaType], map: "recommendations_sender_recipient_content_key")
  @@index([recipientId, status, createdAt], map: "recommendations_recipient_status_created_at_idx")
  @@index([senderId, status, createdAt], map: "recommendations_sender_status_created_at_idx")
  @@map("recommendations")
}

model UserMedia {
  id               String          @id @default(uuid()) @db.Uuid
  userId           String          @map("user_id") @db.Uuid
  provider         String          @db.VarChar(50)
  externalId       Int?            @map("external_id")
  mediaType        String          @map("media_type") @db.VarChar(16)
  status           UserMediaStatus @default(WATCHLIST)
  title            String          @db.VarChar(500)
  originalTitle    String?         @map("original_title") @db.VarChar(500)
  originalLanguage String?         @map("original_language") @db.VarChar(100)
  nationality      String?         @db.VarChar(100)
  synopsis         String?         @db.VarChar(5000)
  posterUrl        String?         @map("poster_url")
  releaseYear      Int?            @map("release_year")
  genreIds         Int[]           @default([]) @map("genre_ids")
  manualCategories String[]        @default([]) @map("manual_categories")
  watchedAt        DateTime?       @map("watched_at")
  personalRating   Decimal?        @db.Decimal(3, 1) @map("personal_rating")
  privateComment   String?         @db.VarChar(2000) @map("private_comment")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, externalId, mediaType], map: "user_media_user_provider_external_type_key")
  @@index([userId, status, createdAt], map: "user_media_user_status_created_at_idx")
  @@index([userId, status, watchedAt], map: "user_media_user_status_watched_at_idx")
  @@index([userId, mediaType], map: "user_media_user_media_type_idx")
  @@map("user_media")
}

model RefreshSession {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  familyId       String   @map("family_id") @db.Uuid
  tokenHash      String   @unique @map("token_hash")
  expiresAt      DateTime @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  replacedById   String?  @unique @map("replaced_by_id") @db.Uuid
  userAgent      String?  @map("user_agent")
  ipAddress      String?  @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy     RefreshSession? @relation("RefreshRotation", fields: [replacedById], references: [id])
  replacedFrom   RefreshSession? @relation("RefreshRotation")

  @@index([userId], map: "refresh_sessions_user_id_idx")
  @@index([familyId], map: "refresh_sessions_family_id_idx")
  @@map("refresh_sessions")
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId], map: "email_verification_tokens_user_id_idx")
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId], map: "password_reset_tokens_user_id_idx")
  @@map("password_reset_tokens")
}

model ExternalIdentity {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  provider       String   @db.VarChar(50)
  providerSubject String  @map("provider_subject")
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerSubject], map: "external_identities_provider_subject_key")
  @@index([userId], map: "external_identities_user_id_idx")
  @@map("external_identities")
}
