generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PreferredLanguage {
  ES
  EN
}

enum Theme {
  SYSTEM
  LIGHT
  DARK
}

enum UserMediaStatus {
  WATCHLIST
  WATCHED
}

model User {
  id                 String            @id @default(uuid()) @db.Uuid
  email              String            @unique @db.VarChar(254)
  emailNormalized    String            @unique @map("email_normalized") @db.VarChar(254)
  passwordHash       String            @map("password_hash")
  emailVerifiedAt    DateTime?         @map("email_verified_at")
  username           String?           @db.VarChar(30)
  usernameNormalized String?           @db.VarChar(30) @map("username_normalized")
  displayName        String            @db.VarChar(80) @map("display_name")
  avatarUrl          String?           @map("avatar_url")
  preferredLanguage  PreferredLanguage @default(ES) @map("preferred_language")
  theme              Theme             @default(SYSTEM)
  lastLoginAt        DateTime?         @map("last_login_at")
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  deletedAt          DateTime?         @map("deleted_at")
  refreshSessions    RefreshSession[]
  verificationTokens EmailVerificationToken[]
  passwordResetTokens PasswordResetToken[]
  externalIdentities ExternalIdentity[]
  libraryItems       UserMedia[]

  @@index([deletedAt], map: "users_deleted_at_idx")
  @@map("users")
}

model UserMedia {
  id          String          @id @default(uuid()) @db.Uuid
  userId      String          @map("user_id") @db.Uuid
  provider    String          @db.VarChar(50)
  externalId  Int             @map("external_id")
  mediaType   String          @map("media_type") @db.VarChar(16)
  status      UserMediaStatus @default(WATCHLIST)
  title       String          @db.VarChar(500)
  posterUrl   String?         @map("poster_url")
  releaseYear Int?            @map("release_year")
  genreIds    Int[]           @default([]) @map("genre_ids")
  watchedAt   DateTime?       @map("watched_at")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, provider, externalId, mediaType], map: "user_media_user_provider_external_type_key")
  @@index([userId, status, createdAt], map: "user_media_user_status_created_at_idx")
  @@index([userId, status, watchedAt], map: "user_media_user_status_watched_at_idx")
  @@index([userId, mediaType], map: "user_media_user_media_type_idx")
  @@map("user_media")
}

model RefreshSession {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  familyId       String   @map("family_id") @db.Uuid
  tokenHash      String   @unique @map("token_hash")
  expiresAt      DateTime @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  replacedById   String?  @unique @map("replaced_by_id") @db.Uuid
  userAgent      String?  @map("user_agent")
  ipAddress      String?  @map("ip_address")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  replacedBy     RefreshSession? @relation("RefreshRotation", fields: [replacedById], references: [id])
  replacedFrom   RefreshSession? @relation("RefreshRotation")

  @@index([userId], map: "refresh_sessions_user_id_idx")
  @@index([familyId], map: "refresh_sessions_family_id_idx")
  @@map("refresh_sessions")
}

model EmailVerificationToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId], map: "email_verification_tokens_user_id_idx")
  @@map("email_verification_tokens")
}

model PasswordResetToken {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  tokenHash String   @unique @map("token_hash")
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId], map: "password_reset_tokens_user_id_idx")
  @@map("password_reset_tokens")
}

model ExternalIdentity {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  provider       String   @db.VarChar(50)
  providerSubject String  @map("provider_subject")
  createdAt      DateTime @default(now()) @map("created_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerSubject], map: "external_identities_provider_subject_key")
  @@index([userId], map: "external_identities_user_id_idx")
  @@map("external_identities")
}
